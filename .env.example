# ===================================================================
# S&P Global x CRISIL: AI/NLP Risk Engine & Tactical Stock Index Rebalancer
# Environment Configuration
# ===================================================================

# Application Environment
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with automatic SQLite fallback)
DATABASE_URL=sqlite:///./data/risk_engine.db

# Ingestion Settings: GDELT
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_TIMEOUT_SECONDS=8
GDELT_MAX_RETRIES=2

# Ingestion Settings: Public Financial News Dataset (Kaggle Financial PhraseBank)
# Acquired automatically without credentials
KAGGLE_PUBLIC_DATASET_URL=https://raw.githubusercontent.com/isaaccs/sentiment-analysis-for-financial-news/master/all-data.csv
KAGGLE_CACHE_FILE=./data/kaggle/financial_phrasebank.csv

# Market Data: yfinance
YFINANCE_CACHE_TTL_HOURS=12

# OPTIONAL: Kaggle Official API Credentials
# Only required if downloading private/authenticated Kaggle competitions.
# Leave blank for default automatic free public dataset acquisition.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
